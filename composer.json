{
    "name": "popphp/pop-parser",
    "description": "PHP name and address parsing optional component of the Pop PHP Framework",
    "keywords": [
        "name parsing",
        "address parsing",
        "php",
        "pop",
        "pop php"
    ],
    "homepage": "http://github.com/popphp/pop-parser",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Nick Sagona, III",
            "email": "nick@popphp.org",
            "homepage": "https://www.popphp.org/"
        }
    ],
    "require": {
        "php": ">=8.4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Pop\\Parser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pop\\Parser\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    }
}
